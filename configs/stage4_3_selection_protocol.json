      "selector_version": "aic.lightweight-candidate-selection/v1",
      "parameters": {
        "rules": [
          {
            "rule_id": "explicit_no_highlight",
            "pattern": "(?:无|没有)(?:明显|突出|关键|值得保留的).{0,8}(?:事件|动作|变化|高光|亮点)",
            "positive_override_patterns": []
          },
          {
            "rule_id": "setup_only",
            "pattern": "(?:为|只是|仅为|主要为).{0,12}(?:后续|接下来).{0,12}(?:铺垫|准备)",
            "positive_override_patterns": ["高潮", "关键", "结果", "完整事件", "主要事件", "核心事件", "突发", "惊喜", "兴奋", "互动", "观看价值"]
          },
          {
            "rule_id": "ordinary_only",
            "pattern": "(?:日常生活场景|日常家务活动|普通走动|普通操作|环境扫镜)",
            "positive_override_patterns": ["高潮", "关键", "结果", "完整事件", "主要事件", "核心事件", "突发", "惊喜", "兴奋", "互动", "观看价值"]
          },
          {
            "rule_id": "transition_only",
            "pattern": "(?:仅|只是|单纯|主要是).{0,8}(?:场景切换|转场|过渡)",
            "positive_override_patterns": ["高潮", "关键", "结果", "信息量明显提升", "突发", "惊喜", "兴奋", "互动", "观看价值"]
          },
          {
            "rule_id": "repetition_without_new_information",
            "pattern": "(?:重复|再次).{0,12}(?:无|没有).{0,8}(?:新增|新).{0,8}(?:信息|动作|事件|变化)",
            "positive_override_patterns": ["高潮", "关键", "结果", "更强", "升级", "突发", "惊喜"]
          }
        ]
      },
      "rule_provenance": {
        "source": "Stage 2 frozen error analysis and conservative-filtering lessons only",
        "prohibited_sources": ["Stage 4.1 adjudication", "Audit36 rationales", "Dev166 metric-driven keyword additions"],
        "risk_control": "Bare 准备/铺垫/过渡/重复 tokens are insufficient; contextual pattern plus absence of positive override is required"
      }
    }
